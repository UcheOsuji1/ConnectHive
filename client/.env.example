# Copy to .env — never commit .env
# Production: https://api.truehive.app
VITE_API_URL=http://localhost:5000

# Sentry — optional; enables error tracking for crashes in the browser
# Without this key the app works fully, just with no error reporting
# Create a React project at https://sentry.io to get a DSN
VITE_SENTRY_DSN=
# Filled at build time from the deploy platform's commit SHA
VITE_SENTRY_RELEASE=

# Sentry source maps — optional, build-time only (not read by the app itself)
# Set these three on Vercel to upload source maps on deploy; leave unset
# locally and the build produces no source maps at all
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
