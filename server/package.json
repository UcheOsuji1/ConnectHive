{
  "name": "truehive-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import ./src/instrument.js src/index.js",
    "start": "node --import ./src/instrument.js src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:seed:hives": "node src/db/seedHives.js",
    "db:purge:test-hives": "node src/db/purgeTestHives.js",
    "db:backfill-coords": "node src/scripts/backfillCoordinates.js",
    "billing:worker": "node --import ./src/instrument.js src/jobs/billingWorker.js",
    "check:collab": "node src/checks/collabVocabulary.check.mjs",
    "check:collab-api": "node src/checks/prompt78-collab.mjs",
    "check:collab-match": "node src/checks/collabMatching.check.mjs",
    "check:collab-match-integration": "node src/checks/prompt81-collab-match.integration.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@sentry/node": "^11.8.0",
    "bcryptjs": "^2.4.3",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "resend": "^6.26.0",
    "socket.io": "^4.8.3",
    "stripe": "^23.0.0",
    "truehive": "file:.."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@sentry/bundler-plugins": {
      "glob": "14.0.2"
    },
    "glob": {
      "minimatch": "11.0.1"
    }
  }
}
